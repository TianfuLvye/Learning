# ===== DeepSeek API =====
# 必填：从 https://platform.deepseek.com 获取。未配置时阅读/目录/进度仍可用，AI 功能会显示配置提示。
DEEPSEEK_API_KEY=
# OpenAI 兼容接口的基础地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名称
DEEPSEEK_MODEL=deepseek-chat
# 单次请求超时（毫秒）
DEEPSEEK_TIMEOUT_MS=120000
# 失败后的最大重试次数（不含首次请求）
DEEPSEEK_MAX_RETRIES=2
# 单次输出最大 token 数
DEEPSEEK_MAX_TOKENS=8000
# 采样温度
DEEPSEEK_TEMPERATURE=0.3

# ===== 服务 =====
PORT=3001
# 以下目录均相对于项目根目录，可按需修改
LEARN_DIR=learn
PROMPTS_DIR=prompts
CACHE_DIR=.cache
